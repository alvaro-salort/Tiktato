{
  "name": "tiktato",
  "version": "0.1.1",
  "description": "Alertas de sonido y overlays para donaciones y eventos de TikTok LIVE, sin suscripciones.",
  "main": "electron/main.cjs",
  "author": "Alvaro Salort",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test tests/*.test.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis portable"
  },
  "dependencies": {
    "piratetok-live-js": "^0.3.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.tiktato.app",
    "productName": "Tiktato",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "overlay/**/*",
      "shared/**/*",
      "build/icon.png",
      "package.json",
      "!**/*.map",
      "!tests/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
